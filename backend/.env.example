NODE_ENV=development
PORT=4000
TRUST_PROXY=0

# docker-compose.yml overrides these for its internal service names.
# For `npm run dev` outside Compose, point MONGO_URI at a reachable replica set (transactions are required).
MONGO_URI=mongodb://127.0.0.1:27017/studyloop?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

# Replace both before deployment. Keep access and refresh secrets different.
JWT_ACCESS_SECRET=local-dev-access-secret-change-this-to-a-random-64-character-value
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-this-to-another-random-64-char-value
JWT_ISSUER=studyloop-api
JWT_AUDIENCE=studyloop-client
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Exact allowed browser origins, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ROOM_CAPACITY_MAX=4
MATCH_QUEUE_TTL_SECONDS=180
PRESENCE_LEASE_MS=60000
PRESENCE_HEARTBEAT_MS=20000
